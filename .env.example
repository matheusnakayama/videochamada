# ============================================================================
# VARIÁVEIS DE AMBIENTE - videochamada
# Copie este arquivo para ".env.local" (desenvolvimento) e configure as mesmas
# variáveis no painel da Vercel (Project Settings > Environment Variables)
# para produção.
# ============================================================================

# ---- SINALIZAÇÃO (Pusher Channels) ----------------------------------------
# A sinalização (troca de ofertas/respostas/candidatos ICE do WebRTC) precisa
# de conexões persistentes (WebSocket), que as Funções Serverless da Vercel
# NÃO mantêm. Por isso usamos o Pusher Channels, que hospeda o WebSocket e é
# compatível com deploys 100% serverless.
#
# 1. Crie uma conta gratuita em https://pusher.com (plano Sandbox: 200k
#    mensagens/dia e 100 conexões simultâneas, sem cartão de crédito).
# 2. Crie um app em "Channels".
# 3. Em "App Keys", copie os valores abaixo.
# 4. Em "App Settings", habilite a opção "Enable client events".
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ---- SERVIDORES STUN/TURN (WebRTC) -----------------------------------------
# STUN é gratuito e público (Google) e já está embutido no código, não exige
# configuração. TURN é necessário para conectar participantes atrás de
# redes/NATs restritivas (redes corporativas, 4G de alguns operadores etc.),
# quando a conexão direta P2P não é possível.
#
# Opção A (recomendada): Metered.ca — free tier com 20 GB/mês de relay TURN.
#   1. Crie uma conta em https://www.metered.ca/tools/openrelay/ (ou o painel
#      "TURN Server" do metered.ca).
#   2. Copie a "API Key" do seu app.
#   3. Preencha METERED_API_KEY abaixo. As credenciais TURN serão geradas
#      dinamicamente e com validade curta pela rota /api/turn-credentials,
#      então a chave nunca é exposta ao navegador.
METERED_API_KEY=
METERED_APP_NAME=

# Opção B: servidor TURN próprio ou de outro provedor (ex.: Twilio, Cloudflare
# Calls, coturn autoadministrado). Preencha estas variáveis SE NÃO usar o
# Metered.ca acima. Elas também são usadas apenas no servidor.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- URL PÚBLICA DA APLICAÇÃO ----------------------------------------------
# Usada para montar o link de convite da sala (ex.: https://seu-app.vercel.app).
# Em produção na Vercel, se deixar em branco, o app usa a própria origem do
# navegador automaticamente — esta variável é só um valor de reserva.
NEXT_PUBLIC_APP_URL=http://localhost:3000
